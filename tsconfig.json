{
  "compilerOptions": {
    //"module": "Node16",
    "target": "ES2022",  
    "module": "NodeNext",     // 讓 TS 自動完美適應 Node.js 的模組機制
    "moduleResolution": "NodeNext",    
    "outDir": "out",
    //"rootDir": "src",    
    "lib": [
        "ES2022"
    ],
    "types": [
        "node",
        "mocha"
    ],    
    "sourceMap": true,
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src","test"],
  "exclude": ["mynote" ]
}

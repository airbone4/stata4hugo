{
  "name": "hugo-helper",
  "displayName": "linchao's huto tool",
  "publisher": "linchao",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
 "repository": {
    "type": "git",
    "url": "https://github.com/airbone4/hugo-helper"
 },  
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [ 
      {
        "command": "extension.rmd2ipynb",
        "title": "Hugo tool: R/Markdown to Notebook (.ipynb)"
      },
      {
        "command": "extension.ipynb2md",
        "title": "Hugo tool: Notebook (.ipynb) to Markdown (.md)"
      },
      {
        "command": "extension.ipynb2md_shell",
        "title": "Hugo tool: using jupyter (.ipynb) to (.md)"
      },            
      {
        "command": "extension.rmd2md",
        "title": "Hugo tool: RMarkdown to markdown"
      }  
    ],
    "keybindings": [{
      "command": "extension.ipynb2md_shell",
      "key": "ctrl+m",
      "mac": "cmd+m",
      "when": "editorTextFocus"
    }] ,   
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .ipynb",
          "command": "extension.ipynb2md_shell"
        },
        {
          "when": "resourceExtname == .Rmarkdown || resourceExtname == .rmarkdown || resourceExtname == .rmd || resourceExtname == .Rmd",
          "command": "extension.rmd2md"
        }        
      ]
    }    
  },
  "scripts": {
    "build": "tsc -p .",
    "build:test": "tsc -p tsconfig.test.json",
    "clean": "rimraf out out-test",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && mocha -r ts-node/register test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.105.0",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^10.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "remark-parse": "^10.0.1",
    "remark-stringify": "^10.0.1",
    "unified": "^10.1.2"
  }
}

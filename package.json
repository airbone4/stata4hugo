{
  "name": "hugo-helper",
  "displayName": "linchao's huto tool",
  "publisher": "linchao",
  "version": "0.0.8",
  "engines": {
    "vscode": "^1.140.0"
  },
  "type": "module",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/airbone4/hugo-helper"
  },
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.rmd2ipynb",
        "title": "Hugo tool: R/Markdown to Notebook (.ipynb)"
      },
      {
        "command": "extension.ipynb2md",
        "title": "Hugo tool: Notebook (.ipynb) to Markdown (.md)"
      },
      {
        "command": "extension.ipynb2md_shell",
        "title": "Hugo tool: using jupyter (.ipynb) to (.md)"
      },
      {
        "command": "extension.rmd2md",
        "title": "Hugo tool: RMarkdown to markdown"
      },
      {
        "command": "extension.newnb",
        "title": "Hugo tool: create my stata ipynb"
      },
      {
        "command": "extension.cleanmarkup",
        "title": "Hugo tool: clean markup"
      } ,
      {
        "command": "extension.resetIpynb2mdSettings",
        "title": "Jupyter: Reset ipynb2md Overwrite Prompt Settings"
      }
    ],
    "keybindings": [
      {
        "command": "extension.rmd2md",
        "key": "ctrl+m ctrl+o",
        "mac": "cmd+m cmd+o",
        "when": "editorTextFocus"
      },       {
        "command": "extension.ipynb2md",
        "key": "ctrl+m ctrl+m",
        "mac": "cmd+m cmd+m",
        "when": "editorTextFocus"
      },      
      {
        "command": "extension.ipynb2md_shell",
        "key": "ctrl+m ctrl+j",
        "mac": "cmd+m cmd+j",
        "when": "editorTextFocus"
      },      
      {
        "command": "extension.rmd2ipynb",
        "key": "ctrl+m ctrl+i",
        "mac": "cmd+m cmd+i",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .ipynb",
          "command": "extension.ipynb2md"
        },
        {
          "when": "resourceExtname == .Rmarkdown || resourceExtname == .rmarkdown || resourceExtname == .rmd || resourceExtname == .Rmd",
          "command": "extension.rmd2md"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile ", 
    "xxpretest": "npm run compile && npm run lint", 
    "lint": "eslint src",
    "test": "vscode-test ",
    "test1": "npx tsx test/test_rmd2md.ts",
    "test2": "npx tsx test/newemptynb.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "remark-parse": "^10.0.1",
    "remark-stringify": "^10.0.1",
    "unified": "^10.1.2"
  }
}
